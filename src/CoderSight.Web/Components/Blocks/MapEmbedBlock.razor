@using CoderSight.Core.Blocks.Data

@if (!string.IsNullOrWhiteSpace(Data?.EmbedUrl))
{
    <section class="py-8 px-4">
        <div class="max-w-6xl mx-auto rounded-brand overflow-hidden border border-brand-border">
            <iframe src="@Data.EmbedUrl" width="100%" height="@Data.Height" style="border:0;display:block;" allowfullscreen="" loading="lazy" title="Map"></iframe>
        </div>
    </section>
}

@code {
    [Parameter] public MapEmbedBlockData? Data { get; set; }
}
