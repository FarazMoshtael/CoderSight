@using CoderSight.Core.Blocks.Data

@if (Data?.Style == "brand")
{
    // A rounded band in the primary colour: heading and text on one side, the form on the other.
    <section class="py-12 px-4">
        <div class="max-w-6xl mx-auto bg-brand-blue text-brand-on-blue rounded-brand px-6 py-10 sm:px-10 sm:py-12 flex flex-col md:flex-row md:items-center gap-6 md:gap-10">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl sm:text-3xl font-bold mb-2">@Data.Title</h2>
                @if (!string.IsNullOrEmpty(Data.Description))
                {
                    <p class="opacity-90 text-sm sm:text-base">@Data.Description</p>
                }
            </div>
            <div class="flex-1 min-w-0">
                @Form("bg-white text-brand-navy placeholder-gray-500 border border-transparent focus:ring-brand-navy",
                      "bg-brand-navy text-white hover:opacity-90", "light")
            </div>
        </div>
    </section>
}
else
{
    <section class="py-16 px-4 bg-brand-navy text-white">
        <div class="max-w-2xl mx-auto text-center">
            <h2 class="text-xl sm:text-2xl font-bold mb-3">@Data?.Title</h2>
            @if (!string.IsNullOrEmpty(Data?.Description))
            {
                <p class="text-gray-400 mb-6 text-sm sm:text-base">@Data.Description</p>
            }
            @Form("bg-gray-800 border border-gray-700 text-white placeholder-gray-500 focus:ring-brand-blue",
                  "bg-brand-blue text-brand-on-blue hover:opacity-90", "dark")
        </div>
    </section>
}

@code {
    [Parameter] public NewsletterBlockData? Data { get; set; }

    [CascadingParameter(Name = "TurnstileSiteKey")]
    private string? TurnstileSiteKey { get; set; }

    private RenderFragment Form(string inputClass, string buttonClass, string turnstileTheme) => __builder =>
    {
        <form id="cs-newsletter-form" onsubmit="return csSubscribe(this)">

            <div style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);" aria-hidden="true"><textarea name="cs_hp" tabindex="-1" autocomplete="off" rows="1"></textarea></div>
            <div class="cs-newsletter-row @(Data?.Style == "brand" ? "cs-newsletter-row--fill" : "")">
                <input type="email" name="email" required aria-label="@(Data?.Placeholder ?? "Email")"
                       placeholder="@(Data?.Placeholder ?? "Enter your email")"
                       class="px-4 py-3 rounded-lg focus:outline-none focus:ring-2 @inputClass" />
                <button type="submit" class="px-6 py-3 rounded-lg font-medium transition-opacity @buttonClass">
                    @(Data?.ButtonText ?? "Subscribe")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(TurnstileSiteKey))
            {
                <div class="flex justify-center mt-4">
                    <div class="cf-turnstile" data-sitekey="@TurnstileSiteKey" data-theme="@turnstileTheme" data-size="flexible"></div>
                </div>
            }
        </form>
        <p id="cs-newsletter-msg" class="mt-3 text-sm hidden"></p>
    };
}
