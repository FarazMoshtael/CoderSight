@using CoderSight.Core.Blocks.Data

@{
    var inline = Data?.Layout == "inline";
}
<section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
        @if (!string.IsNullOrEmpty(Data?.SectionTitle))
        {
            <h2 class="text-3xl font-bold text-center text-brand-navy mb-12">@Data.SectionTitle</h2>
        }
        <div class="grid grid-cols-1 @(Data?.Columns > 1 ? "sm:grid-cols-2" : "") md:grid-cols-@(Data?.Columns ?? 3) gap-6">
            @if (Data?.Cards is not null)
            {
                @foreach (var card in Data.Cards)
                {
                    <div class="bg-brand-surface border border-brand-border rounded-brand p-6 hover:shadow-md transition-shadow @(inline ? "flex items-start gap-4" : "")">
                        @if (!string.IsNullOrEmpty(card.ImageUrl))
                        {
                            <img src="@card.ImageUrl" alt="@card.Title" class="@(inline ? "w-16 h-16 shrink-0" : "w-full h-40 mb-4") object-cover rounded-lg" />
                        }
                        else if (!string.IsNullOrEmpty(card.Icon))
                        {
                            <div class="w-12 h-12 shrink-0 bg-brand-blue/10 text-brand-blue rounded-full flex items-center justify-center text-xl @(inline ? "" : "mb-4")">
                                <CsIcon Name="@card.Icon" />
                            </div>
                        }
                        <div class="min-w-0">
                            <h3 class="text-lg font-semibold text-brand-navy mb-2">@card.Title</h3>
                            @if (!string.IsNullOrEmpty(card.Description))
                            {
                                <p class="text-brand-slate text-sm mb-4 whitespace-pre-line">@card.Description</p>
                            }
                            @if (!string.IsNullOrEmpty(card.LinkText))
                            {
                                <a href="@card.LinkUrl" class="text-brand-blue text-sm font-medium hover:text-brand-blue-hover">@card.LinkText <span class="cs-arrow" aria-hidden="true">→</span></a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public CardGridBlockData? Data { get; set; }
}
