@using System.Globalization
@inject ISiteSettingsService SettingsService

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.TwoLetterISOLanguageName"
      dir="@(LayoutDirection.IsRtl(CultureInfo.CurrentCulture) ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=@(_fontFamily.Replace(' ', '+')):wght@300;400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    @if (!string.IsNullOrEmpty(_headingFontFamily) && _headingFontFamily != _fontFamily)
    {
        <link href="https://fonts.googleapis.com/css2?family=@(_headingFontFamily.Replace(' ', '+')):wght@400;500;600;700&display=swap" rel="stylesheet" />
    }
    <style>@((MarkupString)_themeCss)</style>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sora: ['Sora', 'sans-serif'],
                        vazirmatn: ['Vazirmatn', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            blue: 'rgb(var(--cs-primary) / <alpha-value>)',
                            'blue-hover': 'rgb(var(--cs-primary-hover) / <alpha-value>)',
                            'on-blue': 'rgb(var(--cs-on-primary) / <alpha-value>)',
                            navy: 'rgb(var(--cs-ink) / <alpha-value>)',
                            dark: 'rgb(var(--cs-dark) / <alpha-value>)',
                            slate: 'rgb(var(--cs-muted) / <alpha-value>)',
                            surface: 'rgb(var(--cs-surface) / <alpha-value>)',
                            border: 'rgb(var(--cs-border) / <alpha-value>)',
                        },
                    },
                    borderRadius: {
                        brand: 'var(--cs-radius)',
                    },
                },
            },
        }
    </script>
    <style>h1:focus,h2:focus,h3:focus,h4:focus,h5:focus,h6:focus{outline:none !important;box-shadow:none !important;}</style>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CoderSight.Web.styles.css"]" />
    <ImportMap />
    @if (!string.IsNullOrEmpty(_faviconUrl))
    {
        @if (_faviconUrl.EndsWith(".svg", StringComparison.OrdinalIgnoreCase))
        {
            <link rel="icon" type="image/svg+xml" href="@_faviconUrl" />
        }
        else if (_faviconUrl.EndsWith(".ico", StringComparison.OrdinalIgnoreCase))
        {
            <link rel="icon" type="image/x-icon" href="@_faviconUrl" />
        }
        else
        {
            <link rel="icon" type="image/png" href="@_faviconUrl" />
        }
    }
    else
    {
        <link rel="icon" type="image/svg+xml" href="uploads/favicon.svg" />
        <link rel="icon" type="image/png" href="favicon.png" />
    }
    <HeadOutlet />
    @if (!string.IsNullOrEmpty(_gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@_gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@_gaId');
        </script>
    }
</head>

<body class="@(CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "fa" ? "font-vazirmatn" : "font-brand") bg-gray-50 text-brand-navy antialiased">
    <CascadingAuthenticationState>
        <CascadingValue Value="@_siteName" Name="SiteName">
        <CascadingValue Value="@_turnstileSiteKey" Name="TurnstileSiteKey">
            <Routes />
        </CascadingValue>
        </CascadingValue>
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/site.js"]"></script>
    <script>
        function csBlurHeadings(){var f=document.activeElement;if(f&&/^H[1-6]$/.test(f.tagName))f.blur();}
        document.addEventListener('DOMContentLoaded',csBlurHeadings);
        document.addEventListener('enhancedload',csBlurHeadings);
        new MutationObserver(csBlurHeadings).observe(document.body,{childList:true,subtree:true});
        setTimeout(csBlurHeadings,100);
        setTimeout(csBlurHeadings,500);
    </script>
</body>

</html>

@code {
    private string? _gaId;
    private string? _faviconUrl;
    private string _siteName = "CoderSight";
    private string? _turnstileSiteKey;
    private string _fontFamily = ThemeColors.FontFamily;
    private string _headingFontFamily = string.Empty;
    private string _themeCss = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetAsync();
        _gaId = settings?.GoogleAnalyticsId;
        _faviconUrl = settings?.FaviconUrl;
        _siteName = settings?.SiteName ?? "CoderSight";
        _turnstileSiteKey = !string.IsNullOrEmpty(settings?.TurnstileSiteKey) && !string.IsNullOrEmpty(settings?.TurnstileSecretKey)
            ? settings.TurnstileSiteKey : null;
        _fontFamily = ThemeColors.SanitizeFontFamily(settings?.ThemeFontFamily);
        _headingFontFamily = ThemeColors.SanitizeOptionalFontFamily(settings?.ThemeHeadingFontFamily);
        _themeCss = BuildThemeCss(settings ?? new SiteSettings(), _fontFamily, _headingFontFamily);
    }

    private static string BuildThemeCss(SiteSettings s, string fontFamily, string headingFontFamily) =>
        ":root{" +
        $"--cs-primary:{ThemeColors.ToRgbChannels(s.ThemePrimaryColor, ThemeColors.Primary)};" +
        $"--cs-primary-hover:{ThemeColors.ToRgbChannels(s.ThemePrimaryHoverColor, ThemeColors.PrimaryHover)};" +
        $"--cs-on-primary:{ThemeColors.ToRgbChannels(s.ThemeOnPrimaryColor, ThemeColors.OnPrimary)};" +
        $"--cs-ink:{ThemeColors.ToRgbChannels(s.ThemeInkColor, ThemeColors.Ink)};" +
        $"--cs-dark:{ThemeColors.ToRgbChannels(s.ThemeDarkColor, ThemeColors.Dark)};" +
        $"--cs-muted:{ThemeColors.ToRgbChannels(s.ThemeMutedColor, ThemeColors.Muted)};" +
        $"--cs-surface:{ThemeColors.ToRgbChannels(s.ThemeSurfaceColor, ThemeColors.Surface)};" +
        $"--cs-border:{ThemeColors.ToRgbChannels(s.ThemeBorderColor, ThemeColors.Border)};" +
        $"--cs-radius:{ThemeColors.SanitizeRadius(s.ThemeRadius)};" +
        $"--cs-font-body:'{fontFamily}';" +
        "}" +
        (string.IsNullOrEmpty(headingFontFamily)
            ? string.Empty
            : $"h1,h2,h3,.font-heading{{font-family:'{headingFontFamily}',var(--cs-font-body),sans-serif;}}");
}
